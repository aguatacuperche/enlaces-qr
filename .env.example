# Copia este fichero a .env y rellénalo. El .env no se sube nunca al repositorio.

# ---------- El centro ----------

# Nombre del centro (cabecera de las páginas públicas) y texto del pie.
NOMBRE_CENTRO=Colegio Ejemplo
PIE=Colegio Ejemplo · Ciudad

# Dominio de las cuentas de Google del centro: solo entran cuentas de este dominio.
DOMINIO_CORREO=colegio.example

# Cuentas del dominio que no pueden entrar: expresión regular sobre la parte antes de la @.
# Por ejemplo, si los correos de los alumnos llevan cifras (nombre2012a) y los de los profesores no: \d
# Vacía, entra cualquier cuenta del dominio.
CORREOS_EXCLUIDOS=

# Botones de la página de enlace no encontrado (opcionales).
WEB_CENTRO=https://colegio.example
AULA_VIRTUAL=

# Comprobación semanal de que los destinos siguen abriendo (necesita salida a internet). «no» la desactiva.
# COMPROBAR_ENLACES=no

# Informe mensual por correo a quien tenga enlaces que no abren (el primer lunes de cada mes, 8:00).
# Con Google Workspace: smtp.gmail.com y una contraseña de aplicación de la cuenta que envía
# (necesita la verificación en dos pasos). Sin usuario y contraseña, no se envía nada.
# SMTP_HOST=smtp.gmail.com
# SMTP_PUERTO=587         (587 con STARTTLS; algunos proveedores bloquean la salida al 465)
# SMTP_USUARIO=cuenta@colegio.example
# SMTP_CONTRASENA=CAMBIAR
# CORREO_REMITENTE=Enlaces del colegio <cuenta@colegio.example>
# INFORME_MENSUAL=no        (lo desactiva aunque haya SMTP)

# Zona horaria para contar las visitas por día.
ZONA_HORARIA=Europe/Madrid

# Carpeta con la marca del centro (marca.json, logo.svg, isotipo.svg), montada en el contenedor.
# Sin ella, la de ejemplo (marca-ejemplo/).
# MARCA_DIR=/ruta/a/la/marca

# ---------- La app ----------

# Dirección pública, sin barra final.
URL_PUBLICA=https://enlaces.colegio.example

# Para nginx-proxy. Mientras estén comentadas, la app no se publica.
# VIRTUAL_HOST=enlaces.colegio.example
# LETSENCRYPT_HOST=enlaces.colegio.example

# Redes de Docker que ya existen: la del proxy y la de PostgreSQL.
RED_PROXY=CAMBIAR
RED_BD=CAMBIAR

# Base de datos PostgreSQL 17.
DATABASE_URL=postgres://enlaces:CAMBIAR@postgres:5432/enlaces

# Secreto para firmar la cookie de sesión: una cadena larga al azar (por ejemplo, `openssl rand -hex 32`).
SECRETO_SESION=CAMBIAR

# Cliente OAuth de Google Cloud (tipo «Aplicación web»), del Workspace del centro.
# URI de redirección autorizada: <URL_PUBLICA>/auth/google/callback
GOOGLE_CLIENT_ID=CAMBIAR.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CAMBIAR

# Solo en desarrollo: entrar escribiendo un correo, sin Google. La app no arranca con esto en producción.
# ENTRADA_DE_PRUEBA=si
