<%- include('parciales/cabeza', { titulo }) %>
<main class="nf">
  <div class="nf-marca"><img src="/marca/isotipo.svg" alt=""><%= centro.nombre %></div>
  <div class="nf-caja">
    <h1><%= titulo %></h1>
    <p><%= mensaje %></p>
    <% const salida = locals.enlace ?? (locals.usuario ? { href: '/panel', texto: 'Volver a mis enlaces' } : centro.web ? { href: centro.web, texto: 'Ir a la web del centro' } : null); %>
    <% if (salida) { %><a class="btn" href="<%= salida.href %>"><%= salida.texto %></a><% } %>
  </div>
</main>
</body>
</html>
