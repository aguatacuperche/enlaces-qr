<%
  const radio = (grupo, valor, contenido) => `<label><input type="radio" name="${grupo}" value="${valor}" ${o[grupo] === valor ? 'checked' : ''}><span>${contenido}</span></label>`;
  const base = `/panel/enlaces/${e.id}/qr`;
  const escaparHtml = t => t.replace(/[<>&"]/g, ch => ({ '<': '&lt;', '>': '&gt;', '&': '&amp;', '"': '&quot;' })[ch]);
%>
<%- include('parciales/cabeza', { titulo: 'Código QR' }) %>
<%- include('parciales/barra', { seccion: usuario.id === e.usuario_id ? 'mios' : 'todos' }) %>
<main class="cuerpo">
  <div class="miga"><a href="/panel/enlaces/<%= e.id %>"><svg class="i"><use href="#i-volver"/></svg><%= e.titulo %></a><span>/</span><b>Código QR de <%= corta(e.nombre) %></b></div>
  <form class="creador" id="creador" method="get" action="<%= base %>" data-base="<%= base %>">
    <div class="opciones">
      <fieldset class="grupo"><legend>Color</legend>
        <div class="segmento">
          <%- radio('color', 'marca', '<i class="muestra multi"></i>Del centro') %>
          <% for (const p of ['principal', 'segundo', 'tercero', 'oscuro']) { %>
            <%- radio('color', p, `<i class="muestra" style="background:var(--${p})"></i>${escaparHtml(colores[p].nombre)}`) %>
          <% } %>
        </div>
        <p class="nota">El <%= colores.acento.nombre.toLowerCase() %> solo va en el logo: sobre blanco, un QR de ese color cuesta de leer.</p>
      </fieldset>
      <fieldset class="grupo"><legend>Puntos</legend>
        <div class="segmento">
          <%- radio('puntos', 'redondeados', '<svg viewBox="0 0 18 18"><path d="M2 2h5a2.5 2.5 0 0 1 0 5H2zM9 9h5a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H11a2 2 0 0 1-2-2z" fill="currentColor"/></svg>Redondeados') %>
          <%- radio('puntos', 'circulos', '<svg viewBox="0 0 18 18"><circle cx="4.5" cy="4.5" r="2.5" fill="currentColor"/><circle cx="12.5" cy="12.5" r="2.5" fill="currentColor"/><circle cx="12.5" cy="4.5" r="2.5" fill="currentColor"/></svg>Círculos') %>
          <%- radio('puntos', 'cuadrados', '<svg viewBox="0 0 18 18"><path d="M2 2h5v5H2zM10 10h6v6h-6zM10 2h5v5h-5z" fill="currentColor"/></svg>Cuadrados') %>
        </div>
      </fieldset>
      <fieldset class="grupo"><legend>Esquinas</legend>
        <div class="segmento">
          <%- radio('esquinas', 'redondeadas', '<svg viewBox="0 0 18 18"><rect x="2" y="2" width="14" height="14" rx="4" fill="none" stroke="currentColor" stroke-width="2.4"/><rect x="6.5" y="6.5" width="5" height="5" rx="1.5" fill="currentColor"/></svg>Redondeadas') %>
          <%- radio('esquinas', 'circulo', '<svg viewBox="0 0 18 18"><circle cx="9" cy="9" r="7" fill="none" stroke="currentColor" stroke-width="2.4"/><circle cx="9" cy="9" r="2.8" fill="currentColor"/></svg>Círculo') %>
          <%- radio('esquinas', 'cuadradas', '<svg viewBox="0 0 18 18"><rect x="2" y="2" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4"/><rect x="6.5" y="6.5" width="5" height="5" fill="currentColor"/></svg>Cuadradas') %>
        </div>
      </fieldset>
      <fieldset class="grupo"><legend>En el centro</legend>
        <div class="segmento">
          <%- radio('centro', 'logo', '<img src="/marca/isotipo.svg" alt="">El logo del centro') %>
          <%- radio('centro', 'nada', 'Nada') %>
        </div>
      </fieldset>
      <fieldset class="grupo"><legend>Marco</legend>
        <div class="segmento">
          <%- radio('marco', 'escaneame', '«Escanéame»') %>
          <%- radio('marco', 'nombre', 'Nombre del enlace') %>
          <%- radio('marco', 'libre', 'Texto propio') %>
          <%- radio('marco', 'no', 'Sin marco') %>
        </div>
        <div class="campo texto-libre" <%= o.marco === 'libre' ? '' : 'hidden' %> id="texto-libre"><input name="texto" value="<%= o.texto %>" maxlength="28" placeholder="Por ejemplo: Autorización excursión" aria-label="Texto del marco"></div>
      </fieldset>
      <fieldset class="grupo"><legend>Fondo</legend>
        <div class="segmento">
          <%- radio('fondo', 'blanco', 'Blanco') %>
          <%- radio('fondo', 'transparente', 'Transparente') %>
        </div>
      </fieldset>
    </div>

    <div class="vista">
      <div class="vista-cab">
        <div class="pestanas-qr" role="tablist" aria-label="Qué descargar">
          <% for (const [m, t] of [['codigo', 'Código QR'], ['cartel', 'Cartel'], ['pegatinas', 'Pegatinas']]) { %>
            <button type="button" role="tab" data-modo="<%= m %>" aria-selected="<%= modo === m %>"><%= t %></button>
          <% } %>
        </div>
        <span class="lectura" id="lectura" aria-live="polite"><svg class="i"><use href="#i-ok"/></svg>Comprobando…</span>
      </div>
      <input type="hidden" name="modo" value="<%= modo %>" id="modo">

      <div data-panel="codigo" <%= modo === 'codigo' ? '' : 'hidden' %>>
        <div class="lienzo <%= o.fondo === 'transparente' ? 'cuadros' : '' %>" id="lienzo">
          <img id="vista-previa" src="<%= base %>.svg?<%= consulta(o) %>" alt="Vista previa del código QR de <%= corta(e.nombre) %>">
        </div>
        <fieldset class="grupo" style="padding:0;border:0"><legend class="oculto">Tamaño</legend>
          <div class="tamanos">
            <% for (const [clave, t] of Object.entries(tamanos)) { %>
              <label><input type="radio" name="tamano" value="<%= clave %>" <%= o.tamano === clave ? 'checked' : '' %>><span><b><%= t.nombre %></b><small><%= t.cm ? `${t.cm} × ${t.cm} cm` : `${t.px} px` %></small></span></label>
            <% } %>
          </div>
        </fieldset>
        <div class="descargas">
          <a class="btn" data-formato="qr.png" href="<%= base %>.png?<%= consulta(o) %>&amp;descargar=1"><svg class="i"><use href="#i-bajar"/></svg>PNG</a>
          <a class="btn" data-formato="qr.svg" href="<%= base %>.svg?<%= consulta(o) %>&amp;descargar=1"><svg class="i"><use href="#i-bajar"/></svg>SVG</a>
          <a class="btn" data-formato="qr.pdf" href="<%= base %>.pdf?<%= consulta(o) %>&amp;descargar=1"><svg class="i"><use href="#i-bajar"/></svg>PDF</a>
          <button type="button" class="btn suave" id="copiar-imagen"><svg class="i"><use href="#i-imagen"/></svg>Copiar imagen</button>
          <button type="button" class="btn suave" data-copiar="<%= urlCorta(e.nombre) %>"><svg class="i"><use href="#i-copiar"/></svg>Copiar enlace</button>
        </div>
        <p class="nota">El PNG sale a 300 ppp para el tamaño elegido y el PDF lo coloca a su tamaño real en un folio (o un A3 para el cartel). El SVG vale para cualquier tamaño.</p>
      </div>

      <div data-panel="cartel" <%= modo === 'cartel' ? '' : 'hidden' %>>
        <div class="ajustes-impresion">
          <div class="segmento" role="radiogroup" aria-label="Tamaño del cartel">
            <label><input type="radio" name="cartel_tamano" value="a4" checked><span>Folio A4</span></label>
            <label><input type="radio" name="cartel_tamano" value="a3"><span>Cartel A3</span></label>
          </div>
          <label class="campo"><input name="cartel_titulo" value="<%= e.titulo %>" maxlength="140" aria-label="Título del cartel" placeholder="Título del cartel"></label>
          <label class="campo"><input name="cartel_texto" maxlength="300" aria-label="Explicación" placeholder="Explicación (opcional): «Escanea para rellenar la autorización»"></label>
        </div>
        <iframe class="vista-pdf" data-pdf="cartel" title="Vista previa del cartel"></iframe>
        <div class="descargas">
          <a class="btn" data-formato="cartel.pdf" href="#"><svg class="i"><use href="#i-imprimir"/></svg>Descargar el cartel (PDF)</a>
        </div>
        <p class="nota">Lleva arriba el logo del centro, el QR con el estilo de la izquierda y, debajo, la dirección escrita para quien no pueda escanear.</p>
      </div>

      <div data-panel="pegatinas" <%= modo === 'pegatinas' ? '' : 'hidden' %>>
        <div class="ajustes-impresion">
          <label class="campo"><select name="hoja" id="hoja" aria-label="Hoja de etiquetas">
            <% for (const [clave, h] of Object.entries(hojas)) { %><option value="<%= clave %>"><%= h.nombre %></option><% } %>
            <option value="medida">A medida…</option>
          </select></label>
          <fieldset class="medida" id="medida" hidden>
            <legend>Medidas en milímetros (vienen en la caja)</legend>
            <% for (const [k, t, v] of [['m_columnas', 'Columnas', 3], ['m_filas', 'Filas', 7], ['m_ancho', 'Ancho', 70], ['m_alto', 'Alto', '42,4'], ['m_sup', 'Margen arriba', 0], ['m_izq', 'Margen izquierda', 0], ['m_seph', 'Separación entre columnas', 0], ['m_sepv', 'Separación entre filas', 0]]) { %>
              <label><span><%= t %></span><input name="<%= k %>" inputmode="decimal" value="<%= v %>"></label>
            <% } %>
          </fieldset>
          <div class="dos-campos">
            <label><span>Empezar en la etiqueta</span><input type="number" name="empezar" min="1" value="1"></label>
            <label><span>Cuántas</span><input type="number" name="cuantas" min="1" max="400" placeholder="Hasta llenar la hoja"></label>
          </div>
          <div class="segmento" role="radiogroup" aria-label="Texto de cada pegatina">
            <label><input type="radio" name="pegatina_texto" value="titulo" checked><span>Título y dirección</span></label>
            <label><input type="radio" name="pegatina_texto" value="direccion"><span>Solo la dirección</span></label>
            <label><input type="radio" name="pegatina_texto" value="nada"><span>Solo el QR</span></label>
          </div>
          <label class="casilla"><input type="checkbox" name="bordes" value="si">Marcar los bordes (para probar primero en un folio)</label>
        </div>
        <iframe class="vista-pdf" data-pdf="pegatinas" title="Vista previa de la hoja de pegatinas"></iframe>
        <div class="descargas">
          <a class="btn" data-formato="pegatinas.pdf" href="#"><svg class="i"><use href="#i-imprimir"/></svg>Descargar las pegatinas (PDF)</a>
        </div>
        <p class="nota"><b>Imprime al 100 %</b>, sin «ajustar a la página», o no cuadrarán con las etiquetas. En las pegatinas el código va sin marco: el texto va al lado.</p>
      </div>
    </div>
    <noscript><button class="btn">Ver la vista previa</button></noscript>
  </form>
</main>
<script src="<%= recurso('qr.js') %>"></script>
<%- include('parciales/pie') %>
