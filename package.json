{
  "name": "enlaces-qr",
  "version": "1.0.0",
  "description": "Enlaces cortos y códigos QR para colegios",
  "license": "MIT",
  "author": "Enrique Robredo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/servidor.ts",
    "dev": "node --watch --env-file-if-exists=.env src/servidor.ts",
    "tipos": "tsc --noEmit",
    "test": "vitest run",
    "migrar": "node --env-file-if-exists=.env scripts/migrar.ts"
  },
  "dependencies": {
    "@fontsource/nunito": "5.3.0",
    "@resvg/resvg-js": "2.6.2",
    "connect-pg-simple": "10.0.0",
    "csv-parse": "7.0.3",
    "ejs": "6.0.1",
    "express": "5.2.1",
    "express-session": "1.19.0",
    "helmet": "8.3.0",
    "jsqr": "1.4.0",
    "nodemailer": "10.0.14",
    "openid-client": "6.8.8",
    "opentype.js": "2.0.0",
    "pdfkit": "0.20.2",
    "pg": "8.23.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "7.0.3",
    "@types/ejs": "3.1.5",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/node": "22.20.4",
    "@types/nodemailer": "8.0.2",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "8.23.1",
    "@types/pngjs": "6.0.5",
    "@types/qrcode": "1.5.6",
    "pngjs": "7.0.0",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
